# Copy to .env and fill in. .env is gitignored.

# Postgres connection (defaults to a local dev cluster on :5433 if unset)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/ascenddv

# Session signing secret — use a long random value in any real deployment
JWT_SECRET=dev-only-secret-change-in-production

# Google Gemini — powers generateInsight() and column mapping (mapColumns()).
GEMINI_API_KEY=

# DeepSeek — powers AscendAI chat only (Stage 4). Separate provider, separate
# prepaid balance, separate failure domain from Gemini. OpenAI-compatible API.
# Model is deepseek-chat (not deepseek-reasoner). Prepaid, no auto-recharge.
DEEPSEEK_API_KEY=

# Transactional email (Stage 5) — verification, password reset, team invites.
# With RESEND_API_KEY unset the backend logs each message (and its link) to the
# console instead of sending, which is enough for local dev and the phase gates.
RESEND_API_KEY=
EMAIL_FROM=AscendDV <noreply@yourdomain.example>

# Origin used to build links inside emails and to the app. Set to the deployed
# URL in production (e.g. https://ascend-dv-nine.vercel.app).
APP_BASE_URL=http://localhost:3001

# Set to 0/false/off/no to skip the Have I Been Pwned breached-password check on
# signup and password reset (offline installs, or a HIBP outage). Default:
# enabled. Each fail-open (HIBP unreachable / non-2xx) logs a HIBP_DEGRADED
# signal so a silently-broken check is visible.
# HIBP_CHECK_ENABLED=1

# Guards the internal retention-prune endpoint the Vercel Cron calls
# (POST/GET /api/internal/prune). Set in Vercel; the cron then authorizes
# automatically. Unset -> the endpoint always 401s.
CRON_SECRET=

# Error reporting (Stage 5, Phase 29). Optional. When set AND @sentry/node is
# installed, unhandled 5xx and provider failures are forwarded to Sentry (with
# secrets redacted); otherwise the structured stderr log is the only sink.
SENTRY_DSN=

# AI feature kill-switches (Stage 5). Both default ON; set to 0/false/off to
# disable deployment-wide — the endpoints then return a clean "unavailable" and
# the dashboard hides the affordance instead of erroring.
# INSIGHT_ENABLED=1
# ASCENDAI_ENABLED=1

# Optional overrides
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat   (ASCENDAI_MODEL is an accepted alias)
